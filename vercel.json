{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/candidate/(.*)", "destination": "/candidate/index.html" },
    { "source": "/candidate", "destination": "/candidate/index.html" },
    { "source": "/interviewer/(.*)", "destination": "/interviewer/index.html" },
    { "source": "/interviewer", "destination": "/interviewer/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/proctored-exam/(.*)", "destination": "/proctored-exam/$1" },
    { "source": "/proctored-exam", "destination": "/proctored-exam/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

